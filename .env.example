# Токен бота, полученный у @BotFather
BOT_TOKEN=8475981407:AAEBbd-5lDZTX3FnHDthM9cM2Egx3DMCcJM

# Сколько видео можно скачивать одновременно (asyncio.Semaphore)
MAX_CONCURRENT_DOWNLOADS=3

# Папка для временных файлов на время скачивания/отправки
DOWNLOADS_DIR=downloads

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Жёсткий лимит Telegram Bot API на файлы, отправляемые ботами (МБ).
# Вынесено в конфиг, чтобы будущий обход лимита мог его переопределить.
MAX_FILE_SIZE_MB=2000

# Строка подключения к БД (SQLAlchemy async). По умолчанию — файл
# bot.db в корне проекта через aiosqlite. Для миграции на PostgreSQL
# позже: postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=

# Сколько успешных скачиваний разрешено одному пользователю в сутки
# (UTC-сутки). Пока это просто защита от злоупотреблений — платных
# тарифов ещё нет.
DAILY_DOWNLOAD_LIMIT=5

# Telegram user_id администраторов через запятую — им доступна команда
# /stats. Свой numeric id можно узнать, например, у @userinfobot.
ADMIN_USER_IDS=101676827

# Базовый URL локального Bot API сервера (telegram-bot-api), если он
# поднят — снимает лимит в 50 МБ на отправку файлов (до 2000 МБ).
# Пример: http://localhost:8081
# Пусто = используется обычный облачный Bot API Telegram с лимитом 50 МБ.
TELEGRAM_API_BASE_URL=http://localhost:8081

# Нужны только для docker-compose (запуск локального Bot API сервера),
# самим ботом не читаются. Получить на https://my.telegram.org/apps
TELEGRAM_API_ID=18113229
TELEGRAM_API_HASH=585569e191fe7316eb2dd02c1f1430cc

# Контакт для жалоб на авторские права / запрос на удаление видео —
# показывается пользователям в /terms. Необязателен: если пусто, бот
# просто просит написать администратору, не называя конкретный контакт.
# Пример: @your_support_username или support@example.com
SUPPORT_CONTACT=
