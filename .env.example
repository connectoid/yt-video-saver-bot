# Токен бота, полученный у @BotFather
BOT_TOKEN=

# Сколько видео можно скачивать одновременно (asyncio.Semaphore)
MAX_CONCURRENT_DOWNLOADS=3

# Папка для временных файлов на время скачивания/отправки
DOWNLOADS_DIR=downloads

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Жёсткий лимит Telegram Bot API на файлы, отправляемые ботами (МБ).
# Вынесено в конфиг, чтобы будущий обход лимита мог его переопределить.
MAX_FILE_SIZE_MB=50
